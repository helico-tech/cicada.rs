{
  "messages": {
    "Sleep": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Sleeps `millis` (cancellable: a lost lease interrupts it) and records the run.",
      "properties": {
        "label": {
          "description": "A label for the run.",
          "type": [
            "string",
            "null"
          ]
        },
        "millis": {
          "description": "How long the turn takes.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "millis"
      ],
      "title": "Sleep",
      "type": "object"
    }
  },
  "state": {
    "$defs": {
      "SlowRun": {
        "description": "One completed run of a [`Slow`] turn: who ran it, which claim it was, and when.",
        "properties": {
          "attempt": {
            "description": "The message's `attempt`.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "claimedAt": {
            "description": "The claim time (store time).",
            "format": "date-time",
            "type": "string"
          },
          "finishedAt": {
            "description": "When the sleep ended (the node's clock).",
            "format": "date-time",
            "type": "string"
          },
          "label": {
            "description": "The message's label.",
            "type": [
              "string",
              "null"
            ]
          },
          "messageId": {
            "description": "The message's id.",
            "type": "string"
          },
          "node": {
            "description": "The node that ran it.",
            "type": "string"
          }
        },
        "required": [
          "messageId",
          "attempt",
          "node",
          "claimedAt",
          "finishedAt"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "State of a [`Slow`].",
    "properties": {
      "runs": {
        "default": [],
        "description": "Every completed run.",
        "items": {
          "$ref": "#/$defs/SlowRun"
        },
        "type": "array"
      }
    },
    "title": "SlowState",
    "type": "object"
  },
  "template": "actor://e2e/slow/{id}"
}
