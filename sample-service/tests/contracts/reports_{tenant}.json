{
  "messages": {
    "SyncFinished": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A sync run finished with `imported` items.",
      "properties": {
        "imported": {
          "description": "Items imported by the run.",
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "imported"
      ],
      "title": "SyncFinished",
      "type": "object"
    }
  },
  "state": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "State of [`Reports`]: the item count of every run, oldest first (at most 100).",
    "properties": {
      "runs": {
        "default": [],
        "description": "Item count per run.",
        "items": {
          "format": "int32",
          "type": "integer"
        },
        "type": "array"
      }
    },
    "title": "ReportsState",
    "type": "object"
  },
  "template": "actor://reports/{tenant}"
}
