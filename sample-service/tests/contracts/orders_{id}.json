{
  "messages": {
    "ChargeDeclined": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Payments could not charge the customer; starts the compensation.",
      "properties": {
        "reason": {
          "description": "Why.",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "ChargeDeclined",
      "type": "object"
    },
    "Charged": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Payments charged the customer.",
      "properties": {
        "transactionId": {
          "description": "Identifies the payment.",
          "type": "string"
        }
      },
      "required": [
        "transactionId"
      ],
      "title": "Charged",
      "type": "object"
    },
    "OutOfStock": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Inventory could not reserve the stock.",
      "properties": {
        "available": {
          "description": "The stock that is available.",
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "available"
      ],
      "title": "OutOfStock",
      "type": "object"
    },
    "PlaceOrder": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Places the order: reserve, then charge.",
      "properties": {
        "amountCents": {
          "description": "What to charge.",
          "format": "int64",
          "type": "integer"
        },
        "quantity": {
          "description": "How many.",
          "format": "int32",
          "type": "integer"
        },
        "sku": {
          "description": "The article.",
          "type": "string"
        }
      },
      "required": [
        "sku",
        "quantity",
        "amountCents"
      ],
      "title": "PlaceOrder",
      "type": "object"
    },
    "Released": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Inventory released the reservation (the compensation of [`OrderMsg::Reserved`]).",
      "properties": {},
      "title": "Released",
      "type": "object"
    },
    "Reserved": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Inventory reserved the stock.",
      "properties": {},
      "title": "Reserved",
      "type": "object"
    }
  },
  "state": {
    "$defs": {
      "OrderStatus": {
        "description": "Steps of an [`Order`].",
        "oneOf": [
          {
            "const": "NEW",
            "description": "Not placed yet.",
            "type": "string"
          },
          {
            "const": "RESERVING",
            "description": "Waiting for the inventory.",
            "type": "string"
          },
          {
            "const": "CHARGING",
            "description": "Waiting for the payment.",
            "type": "string"
          },
          {
            "const": "COMPLETED",
            "description": "Reserved and charged.",
            "type": "string"
          },
          {
            "const": "COMPENSATING",
            "description": "Releasing the reservation after a declined payment.",
            "type": "string"
          },
          {
            "const": "CANCELLED",
            "description": "Out of stock, or compensated.",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "State of an [`Order`]: the step machine plus what the steps produced.",
    "properties": {
      "amountCents": {
        "default": 0,
        "description": "What to charge.",
        "format": "int64",
        "type": "integer"
      },
      "failure": {
        "description": "Why the order was cancelled.",
        "type": [
          "string",
          "null"
        ]
      },
      "quantity": {
        "default": 0,
        "description": "How many.",
        "format": "int32",
        "type": "integer"
      },
      "sku": {
        "description": "The article.",
        "type": [
          "string",
          "null"
        ]
      },
      "status": {
        "$ref": "#/$defs/OrderStatus",
        "default": "NEW",
        "description": "The current step."
      },
      "transactionId": {
        "description": "The payment, once charged.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "title": "OrderState",
    "type": "object"
  },
  "template": "actor://orders/{id}"
}
