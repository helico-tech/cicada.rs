{
  "schema": 1,
  "pg_url_variable": "CICADA_PG_URL",
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "line-tables-only",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "kinds": {
    "full": [
      {"name": "python-tests", "argv": ["python3", "-B", "-m", "unittest", "discover", "-s", "scripts", "-p", "test_*.py"]},
      {"name": "fmt", "argv": ["cargo", "fmt", "--all", "--check"]},
      {"name": "clippy", "argv": ["cargo", "clippy", "--workspace", "--all-targets", "--", "-D", "warnings"]},
      {"name": "workspace-tests", "argv": ["cargo", "test", "--workspace"]},
      {"name": "feature-builds", "argv": ["bash", "scripts/ci/feature-builds.sh"]},
      {"name": "app-alone-tests", "argv": ["cargo", "test", "-p", "cicada-app"]},
      {"name": "dependency-trees", "argv": ["bash", "scripts/ci/dependency-trees.sh"]},
      {"name": "client-tests", "argv": ["bash", "scripts/ci/client-tests.sh"]}
    ],
    "docs": [
      {"name": "python-tests", "argv": ["python3", "-B", "-m", "unittest", "discover", "-s", "scripts", "-p", "test_*.py"]},
      {"name": "doctests", "argv": ["cargo", "test", "-p", "cicada-examples", "--doc"]},
      {"name": "docs-tests", "argv": ["cargo", "test", "-p", "cicada-examples", "--test", "docs"]},
      {"name": "skill-tests", "argv": ["cargo", "test", "-p", "cicada-examples", "--test", "skill"]}
    ],
    "e2e": [
      {"name": "e2e", "argv": ["cargo", "test", "-p", "cicada-e2e", "--", "--nocapture"], "env": {"CICADA_E2E": "1"}}
    ]
  },
  "docs_allowlist": {
    "files": ["README.md", "CHANGELOG.md", "AGENTS.md"],
    "markdown_under": ["docs/", "skills/cicada/", ".claude/skills/", "openspec/"],
    "except_under": ["docs/reference/"]
  }
}
